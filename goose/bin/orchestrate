#!/bin/sh
# Interactive orchestrator launcher. Runs the orchestrate recipe through the
# router (pi-acp slot) with -s so the session stays interactive: it asks for
# your task, runs the plan → parallel subtasks → cross-lineage review → gated
# submission pipeline, then leaves you in a normal goose chat to follow up.
#
# Any extra args are passed through, e.g.:
#   orchestrate --params submit=pr
#   orchestrate --params task="Fix bug X" --params submit=never
exec env GOOSE_PROVIDER=pi-acp goose run -s \
  --recipe "$HOME/.config/goose/recipes/orchestrate.yaml" "$@"
